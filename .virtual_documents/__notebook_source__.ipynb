import os
import json
import yaml
import urllib.request
from PIL import Image
from tqdm import tqdm

print("🧹 1. 环境初始化...")
os.makedirs('/kaggle/working/datasets/fathomnet/images/train', exist_ok=True)
os.makedirs('/kaggle/working/datasets/fathomnet/labels/train', exist_ok=True)

print("🗺️ 2. 加载官方 JSON 并修复类别 ID (映射至连续的 0-31)...")
with open('/kaggle/input/competitions/fathomnet-2026/train_dataset.json', 'r') as f:
    coco_data = json.load(f)

sorted_categories = sorted(coco_data['categories'], key=lambda x: x['id'])
coco_to_yolo_id = {}
yolo_names = {}
for yolo_id, cat in enumerate(sorted_categories):
    coco_to_yolo_id[cat['id']] = yolo_id
    yolo_names[yolo_id] = cat['name']

print("⚙️ 3. 生成 fathomnet.yaml 配置文件...")
yaml_data = {
    'path': '/kaggle/working/datasets/fathomnet',
    'train': 'images/train',
    'val': 'images/train', 
    'names': yolo_names
}
with open('/kaggle/working/fathomnet.yaml', 'w') as f:
    yaml.dump(yaml_data, f, default_flow_style=False)

print("✍️ 4. 生成官方正规军的 txt 标签文件...")
img_info = {img['id']: img for img in coco_data['images']}
annotated_img_ids = set()

for ann in coco_data['annotations']:
    img_id = ann['image_id']
    yolo_id = coco_to_yolo_id[ann['category_id']] 
    
    img = img_info[img_id]
    img_w, img_h = img['width'], img['height']
    
    x_min, y_min, bbox_w, bbox_h = ann['bbox']
    x_center = (x_min + bbox_w / 2.0) / img_w
    y_center = (y_min + bbox_h / 2.0) / img_h
    norm_w = bbox_w / img_w
    norm_h = bbox_h / img_h
    
    base_name = img['file_name'].rsplit('.', 1)[0]
    txt_path = os.path.join('/kaggle/working/datasets/fathomnet/labels/train', f"{base_name}.txt")
    
    with open(txt_path, 'a') as f_txt:
        f_txt.write(f"{yolo_id} {x_center:.6f} {y_center:.6f} {norm_w:.6f} {norm_h:.6f}\n")
    annotated_img_ids.add(img_id)

print(f"📥 5. 护盘下载！正在极限压缩 {len(annotated_img_ids)} 张官方图片...")
temp_dl_path = '/kaggle/working/temp_dl_file.tmp'

for img_id in tqdm(annotated_img_ids):
    img = img_info[img_id]
    base_name = img['file_name'].rsplit('.', 1)[0]
    final_img_path = os.path.join('/kaggle/working/datasets/fathomnet/images/train', f"{base_name}.jpg")
    
    if not os.path.exists(final_img_path):
        try:
            urllib.request.urlretrieve(img['coco_url'], temp_dl_path)
            with Image.open(temp_dl_path) as im:
                im = im.convert('RGB')
                im.thumbnail((1024, 1024), Image.Resampling.LANCZOS)
                im.save(final_img_path, format='JPEG', quality=85)
            os.remove(temp_dl_path)
        except Exception as e:
            pass

print("\n🎉 Cell 1 完成！官方基础数据就位。")


import os
import json
import urllib.request
from PIL import Image
from tqdm import tqdm
from ultralytics import RTDETR

# 🚨🚨🚨 必须修改！将下面两个路径替换为你 Add Input 挂载进来的真实路径
best_pt_path = '/kaggle/input/datasets/leomee/weight/best (2).pt'
llava_json_path = '/kaggle/input/notebooks/leomee/fathomnetclef2026-llava/test_pseudo_labels.json'
# 🚨🚨🚨

test_dataset_path = '/kaggle/input/competitions/fathomnet-2026/test_dataset.json'

print("🏗️ 1. 创建伪标签专属营地...")
os.makedirs('/kaggle/working/datasets/pseudo_data/images/train', exist_ok=True)
os.makedirs('/kaggle/working/datasets/pseudo_data/labels/train', exist_ok=True)

print("🤖 2. 唤醒初代 Teacher 模型...")
teacher_model = RTDETR(best_pt_path)

with open(llava_json_path, 'r') as f:
    llava_picks = json.load(f)
with open(test_dataset_path, 'r') as f:
    test_dict = json.load(f)

test_url_map = {img['id']: img['coco_url'] for img in test_dict['images']}
test_name_map = {img['id']: img['file_name'] for img in test_dict['images']}

print(f"🔍 3. 正在提取 {len(llava_picks)} 张盲盒的精确坐标...")
temp_dl = '/kaggle/working/temp_pseudo.jpg'
pseudo_count = 0

for item in tqdm(llava_picks):
    img_id = item['image_id']
    img_url = test_url_map[img_id]
    base_name = test_name_map[img_id].rsplit('.', 1)[0]
    
    img_save_path = f'/kaggle/working/datasets/pseudo_data/images/train/{base_name}.jpg'
    txt_save_path = f'/kaggle/working/datasets/pseudo_data/labels/train/{base_name}.txt'
    
    try:
        urllib.request.urlretrieve(img_url, temp_dl)
        with Image.open(temp_dl) as im:
            im = im.convert('RGB')
            im.thumbnail((1024, 1024), Image.Resampling.LANCZOS)
            im.save(img_save_path, format='JPEG', quality=85)
        os.remove(temp_dl)
        
        # 提纯阈值设定为 0.25
        results = teacher_model.predict(source=img_save_path, conf=0.25, verbose=False)
        boxes = results[0].boxes
        
        if len(boxes) > 0:
            with open(txt_save_path, 'w') as f_txt:
                for box in boxes:
                    x_c, y_c, w, h = box.xywhn[0].tolist()
                    cls_id = int(box.cls[0].item())
                    f_txt.write(f"{cls_id} {x_c:.6f} {y_c:.6f} {w:.6f} {h:.6f}\n")
            pseudo_count += 1
        else:
            os.remove(img_save_path) # 没检测到则丢弃图片，保证纯净
            
    except Exception as e:
        continue

print(f"🎉 Cell 2 完成！成功生成 {pseudo_count} 张高质量伪标签数据。")


import os
import shutil
import glob

official_img_dir = '/kaggle/working/datasets/fathomnet/images/train/'
official_lbl_dir = '/kaggle/working/datasets/fathomnet/labels/train/'

pseudo_img_dir = '/kaggle/working/datasets/pseudo_data/images/train/'
pseudo_lbl_dir = '/kaggle/working/datasets/pseudo_data/labels/train/'

pseudo_imgs = glob.glob(os.path.join(pseudo_img_dir, '*.jpg'))
pseudo_lbls = glob.glob(os.path.join(pseudo_lbl_dir, '*.txt'))

print("\n🚀 开始执行物理融合...")
img_copied = 0
for img_path in pseudo_imgs:
    dest_path = os.path.join(official_img_dir, os.path.basename(img_path))
    if not os.path.exists(dest_path): 
        shutil.copy2(img_path, dest_path)
        img_copied += 1

lbl_copied = 0
for lbl_path in pseudo_lbls:
    dest_path = os.path.join(official_lbl_dir, os.path.basename(lbl_path))
    if not os.path.exists(dest_path):
        shutil.copy2(lbl_path, dest_path)
        lbl_copied += 1

print(f"✅ 融合完成！加入 {img_copied} 张图片和 {lbl_copied} 个标签文件。")

official_imgs_after = len(glob.glob(os.path.join(official_img_dir, '*.jpg')))
official_lbls_after = len(glob.glob(os.path.join(official_lbl_dir, '*.txt')))

print(f"📈 当前终极训练集总图片数: {official_imgs_after} | 总标签数: {official_lbls_after}")
if official_imgs_after == official_lbls_after:
    print("🎉 Cell 3 完成！数据完美对齐，随时可以炼丹！")


