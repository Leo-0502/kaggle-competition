# 1. 必须先安装 WBF 依赖库
get_ipython().getoutput("pip install ensemble-boxes")

import pandas as pd
import json
from ensemble_boxes import weighted_boxes_fusion
from tqdm import tqdm

print("🚀 1. 开始加载模型预测结果与官方图片尺寸...")

# 必须加载官方 test.json 来获取真实的图片宽高，因为 WBF 强制要求坐标必须在 0~1 之间归一化
with open('/kaggle/input/competitions/fathomnet-2026/test_dataset.json', 'r') as f:
    test_data = json.load(f)
img_info = {img['id']: {'w': img['width'], 'h': img['height']} for img in test_data['images']}

# 加载你的两份优质答案 (请确保文件名路径正确)
df1 = pd.read_csv('/kaggle/input/datasets/leomee/sub-0680-csv/submission (1).csv')
df2 = pd.read_csv('/kaggle/input/datasets/leomee/sub-0716-csv/submission (3).csv')

# 核心设定：因为 0.0716 的模型明显更强，我们给它分配 2 倍的权重
weights = [1, 2] 
iou_thr = 0.5     # 两个框重合度达到 50% 就认为是同一个物体进行融合
skip_box_thr = 0.0001

# 把 dataframe 按照 image_id 分组
grouped1 = df1.groupby('image_id')
grouped2 = df2.groupby('image_id')
all_image_ids = set(df1['image_id'].unique()).union(set(df2['image_id'].unique()))

fused_predictions = []
annotation_id = 1

print("🧬 2. 正在执行 WBF (加权框融合) 炼金术...")
for img_id in tqdm(all_image_ids):
    img_w = img_info[img_id]['w']
    img_h = img_info[img_id]['h']
    
    boxes_list = []
    scores_list = []
    labels_list = []
    
    # 提取第一个模型 (0.0680) 的框并归一化
    if img_id in grouped1.groups:
        g = grouped1.get_group(img_id)
        boxes = []
        for _, row in g.iterrows():
            x1, y1 = row['bbox_x'] / img_w, row['bbox_y'] / img_h
            x2, y2 = (row['bbox_x'] + row['bbox_width']) / img_w, (row['bbox_y'] + row['bbox_height']) / img_h
            boxes.append([x1, y1, x2, y2])
        boxes_list.append(boxes)
        scores_list.append(g['score'].tolist())
        labels_list.append(g['category_id'].tolist())
    else:
        boxes_list.append([])
        scores_list.append([])
        labels_list.append([])

    # 提取第二个模型 (0.0716) 的框并归一化
    if img_id in grouped2.groups:
        g = grouped2.get_group(img_id)
        boxes = []
        for _, row in g.iterrows():
            x1, y1 = row['bbox_x'] / img_w, row['bbox_y'] / img_h
            x2, y2 = (row['bbox_x'] + row['bbox_width']) / img_w, (row['bbox_y'] + row['bbox_height']) / img_h
            boxes.append([x1, y1, x2, y2])
        boxes_list.append(boxes)
        scores_list.append(g['score'].tolist())
        labels_list.append(g['category_id'].tolist())
    else:
        boxes_list.append([])
        scores_list.append([])
        labels_list.append([])
        
    # 执行 WBF 融合
    boxes, scores, labels = weighted_boxes_fusion(boxes_list, scores_list, labels_list, weights=weights, iou_thr=iou_thr, skip_box_thr=skip_box_thr)
    
   # 将融合后的归一化坐标反向还原为绝对像素坐标
    for box, score, label in zip(boxes, scores, labels):
        
        # 🚨 终极修复：强制将 score 封顶在 1.0，防止 Kaggle 越界报错！
        safe_score = min(float(score), 1.0)
        
        x1, y1, x2, y2 = box
        bbox_x = x1 * img_w
        bbox_y = y1 * img_h
        bbox_width = (x2 - x1) * img_w
        bbox_height = (y2 - y1) * img_h
        
        fused_predictions.append({
            'annotation_id': annotation_id,
            'image_id': int(img_id),
            'category_id': int(label),
            'bbox_x': bbox_x, 'bbox_y': bbox_y, 'bbox_width': bbox_width, 'bbox_height': bbox_height,
            'score': safe_score
        })
        annotation_id += 1
        
print("📊 3. 正在生成 submission_wbf.csv...")
df_fused = pd.DataFrame(fused_predictions)
columns_order = ['annotation_id', 'image_id', 'category_id', 'bbox_x', 'bbox_y', 'bbox_width', 'bbox_height', 'score']

if not df_fused.empty:
    df_fused = df_fused[columns_order]
else:
    df_fused = pd.DataFrame(columns=columns_order)

df_fused.to_csv('/kaggle/working/submission_wbf.csv', index=False)
print("🎉 融合完成！快去下载 submission_wbf.csv 提交榜单！")


