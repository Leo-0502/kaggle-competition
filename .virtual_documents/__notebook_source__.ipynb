import pandas as pd
import json
import urllib.request
import os
from tqdm import tqdm
from ultralytics import RTDETR

print("🚀 1. 挂载 1024 高清版 Student 终极兵器...")
# 指向你刚刚用 1024 分辨率跑出来的最新权重
best_student_path = '/kaggle/working/rtdetr_runs/fathomnet_student_1024/weights/best.pt'
final_model = RTDETR(best_student_path)

print("🗺️ 2. 加载官方字典，防止类别 ID 错位...")
with open('/kaggle/input/competitions/fathomnet-2026/test_dataset.json', 'r') as f:
    test_data = json.load(f)

# 获取官方的跳号 ID 反向映射字典 (YOLO 的 0-31 翻译回 官方的 1-41)
with open('/kaggle/input/competitions/fathomnet-2026/train_dataset.json', 'r') as f:
    train_data = json.load(f)
yolo_to_coco_id = {yolo_id: cat['id'] for yolo_id, cat in enumerate(sorted(train_data['categories'], key=lambda x: x['id']))}

predictions = []
temp_test_img = "/kaggle/working/temp_infer.jpg"
annotation_id = 1

print(f"🔍 3. 开始对 {len(test_data['images'])} 张测试集图片进行 TTA 增强推理...")
for img_obj in tqdm(test_data['images']):
    try:
        urllib.request.urlretrieve(img_obj['coco_url'], temp_test_img)
        
        # 🚨 核心改动：imgsz=1024 (保持高清)，augment=True (开启TTA测试时增强)，conf=0.1 (防漏检)
        infer_results = final_model.predict(
            source=temp_test_img, 
            imgsz=1024, 
            conf=0.1, 
            augment=True, 
            verbose=False
        )
        
        boxes = infer_results[0].boxes
        
        if len(boxes) > 0:
            for box in boxes:
                # 提取左上角和右下角坐标，计算宽高 (适配官方绝对像素格式)
                x1, y1, x2, y2 = box.xyxy[0].tolist()
                w, h = x2 - x1, y2 - y1
                conf = box.conf[0].item()
                
                # 查字典，将连续 ID 换回官方跳号 ID
                coco_cls = yolo_to_coco_id[int(box.cls[0].item())] 
                
                predictions.append({
                    'annotation_id': annotation_id,
                    'image_id': img_obj['id'],
                    'category_id': coco_cls,
                    'bbox_x': x1, 'bbox_y': y1, 'bbox_width': w, 'bbox_height': h,
                    'score': conf
                })
                annotation_id += 1
                
        os.remove(temp_test_img)
    except Exception as e:
        # 网络波动导致下载失败等情况直接跳过
        continue

print("📊 4. 正在生成符合严格格式的 submission.csv...")
df = pd.DataFrame(predictions)
columns_order = ['annotation_id', 'image_id', 'category_id', 'bbox_x', 'bbox_y', 'bbox_width', 'bbox_height', 'score']

if not df.empty:
    df = df[columns_order]
else:
    # 极端防线：如果什么都没预测出来，建一个空表防止提交报错
    df = pd.DataFrame(columns=columns_order)

df.to_csv('/kaggle/working/submission.csv', index=False)

print("🎉 彻底完成！")


